{
  "manifest_version": 3,
  "name": "Novabird-phishing",
  "version": "0.9.2",
  "description": "__MSG_extensionDescription__",
  "author": "NovaBird",
  "browser_specific_settings": {
    "gecko": {
      "id": "phishing-addon@novabird",
      "strict_min_version": "153.0"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "message_display_scripts": [
    {
      "js": [
        "src/content/linkpolicy.js",
        "src/content/banner.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "permissions": [
    "accountsRead",
    "addressBooks",
    "downloads",
    "menus",
    "messagesModify",
    "messagesRead",
    "messagesTags",
    "messagesTagsList",
    "messagesUpdate",
    "storage"
  ],
  "optional_permissions": [
    "messagesMove"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http: https:"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "homepage_url": "https://github.com/Novabird-Addons/Phishing",
  "default_locale": "en"
}
